{
  "name": "codestats-readme",
  "version": "1.0.0",
  "packageManager": "pnpm@11.17.0",
  "description": "Add codestats metrics to your readme file",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "tsc",
    "build:clean": "rm -rf dist && pnpm run build",
    "dev": "tsx src/index.ts",
    "lint": "pnpm run lint:ts && pnpm run lint:md",
    "lint:ts": "eslint src/**/*.ts",
    "lint:md": "markdownlint-cli2 '**/*.md' '!node_modules/**/*'",
    "lint:fix": "pnpm run lint:ts:fix && pnpm run lint:md:fix",
    "lint:ts:fix": "eslint src/**/*.ts --fix",
    "lint:md:fix": "markdownlint-cli2 '**/*.md' '!node_modules/**/*' --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "cz",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vergissberlin/codestats-readme.git"
  },
  "keywords": [
    "codestats",
    "github",
    "workflow"
  ],
  "author": "André Lademann",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vergissberlin/codestats-readme/issues"
  },
  "homepage": "https://github.com/vergissberlin/codestats-readme#readme",
  "dependencies": {
    "bars": "github:jstrace/bars",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "markdownlint-cli2": "^0.23.2",
    "nock": "^14.0.16",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
